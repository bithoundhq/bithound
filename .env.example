# Example environment for bithound. Copy to `.env` (or load with
# your process supervisor's secret-management mechanism), fill in
# real values, and KEEP IT OUT OF GIT.
#
# Every `*_env` field in bithound.toml resolves to one of the names
# below. If a name listed here is missing at startup, the sidecar
# refuses to start with `config error: missing required env var: …`
# and exits 78. Names that aren't referenced by your config are
# ignored.

# ---- Bitcoin Core RPC credentials ----
# Referenced by [bitcoin_nodes.auth].password_env when auth.type is
# "user_pass". Not needed if you use cookie_file auth.
BITHOUND_BITCOIN_ALICE_PASSWORD=replace-me

# ---- Telegram bot ----
# Referenced by [notifications.telegram].bot_token_env. One token
# serves every Telegram rule (each rule supplies its own chat_id).
# Format: <bot_id>:<long-token-string> (from @BotFather).
BITHOUND_TELEGRAM_BOT_TOKEN=000000000:replace-with-real-token

# ---- Discord webhook URLs ----
# One env var per Discord rule's webhook_env. The full Discord
# webhook URL is the credential, so it lives only here.
BITHOUND_OPS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACE/ME

# ---- Generic webhook URLs (PagerDuty, custom HTTP, etc.) ----
# One env var per Webhook rule's url_env. The URL is the credential.
BITHOUND_OPS_PAGERDUTY_WEBHOOK=https://events.pagerduty.com/v2/enqueue-or-similar

# ---- Optional: BITHOUND_* env overrides for non-secret keys ----
# Format is BITHOUND_<SECTION>__<KEY> (note the DOUBLE underscore).
# Sections may contain single underscores; the section/key boundary
# is the first `__`. Useful for tests and one-off runs; production
# deployments should stick to the TOML file.
#
# BITHOUND_RUNTIME__CHANNEL_CAPACITY=64
# BITHOUND_STORAGE__DB_PATH=/tmp/bithound-test.db
